{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXM Boot",
  "version": "0.1.0",
  "identifier": "com.sxm.boot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SXM Boot",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Créateur de clé USB multiboot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "udisks2",
          "polkit",
          "util-linux",
          "tar"
        ]
      }
    },
    "copyright": "© 2026 Laurent Honoré",
    "license": "GPL-3.0-or-later",
    "publisher": "Laurent Honoré",
    "licenseFile": "../LICENSE"
  }
}